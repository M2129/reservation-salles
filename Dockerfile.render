# Le Dockerfile Render reste explicite pour la configuration du service web.
# Il utilise la même image HTTP que le Dockerfile principal afin que Docker Hub
# et Render exécutent exactement le même processus.
FROM php:8.3-fpm

RUN apt-get update && apt-get install -y \
        $PHPIZE_DEPS \
        git \
        nginx \
        gettext-base \
        unzip \
        libicu-dev \
        libzip-dev \
        libonig-dev \
    && docker-php-ext-install pdo pdo_mysql mbstring intl opcache \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --optimize-autoloader
COPY . .
RUN composer dump-autoload --optimize --no-dev

COPY docker/nginx/render.conf.template /etc/nginx/templates/default.conf.template
COPY docker/render-entrypoint.sh /usr/local/bin/render-entrypoint
RUN chmod +x /usr/local/bin/render-entrypoint

EXPOSE 10000
ENTRYPOINT ["render-entrypoint"]