{
    "name": "odc/reservation-salles-universitaires",
    "description": "Gestion des réservations de salles universitaires — projet PHP OOP (ODC Sonatel Academy)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "nikic/fast-route": "^1.3",
        "respect/validation": "^2.4",
        "illuminate/database": "^12.0",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
