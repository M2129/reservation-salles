APP_ENV=development
APP_DEBUG=true

# --- Base de données ---
# IMPORTANT : à l'intérieur de Docker, l'hôte de la base n'est jamais
# "localhost" mais le nom du service défini dans docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=university_rooms
DB_USERNAME=app
DB_PASSWORD=app_password

# --- Variables utilisées directement par le service mysql de docker-compose ---
MYSQL_DATABASE=university_rooms
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password
